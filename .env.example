# SchoolDay uses fixtures by default for local development and tests.
# Copy this file to .env and keep that file private (chmod 600 is recommended).
# Docker Compose reads .env automatically. Never commit real credentials.
# Set ORIGIN to the browser-facing HTTPS URL when using an authenticated proxy or tunnel.
SCHOOLDAY_IMAGE=ghcr.io/rryankees08/schoolday:latest
ORIGIN=http://localhost:3000
# Host port published by Docker Compose. It remains bound to 127.0.0.1.
SCHOOLDAY_PORT=3000
# Name used in the dashboard greeting; defaults to "Student".
SCHOOLDAY_DISPLAY_NAME=Student

# Optional outside Docker. When set, live StudentVUE grade history persists in SQLite.
SCHOOLDAY_DB_PATH=

# Server-only Canvas REST API credentials. Never expose CANVAS_TOKEN to browser code.
CANVAS_BASE_URL=
CANVAS_TOKEN=
# Optional browser destination when it differs from the API base URL.
CANVAS_WEB_URL=

# Server-only StudentVUE web portal credentials. Use the portal origin, without a page path.
STUDENTVUE_BASE_URL=https://parent.example.edu
STUDENTVUE_USERNAME=
STUDENTVUE_PASSWORD=
# Optional browser destination when it differs from the portal base URL.
STUDENTVUE_WEB_URL=

# Bell-Logic's base URL (or full /v1/state URL) and an origin allowlisted by Bell-Logic.
BELLLOGIC_API_URL=https://api.bell-logic.us
BELLLOGIC_REQUEST_ORIGIN=https://bell-logic.us
# Optional browser destination; defaults to BELLLOGIC_REQUEST_ORIGIN.
BELLLOGIC_WEB_URL=
