{
  "name": "schoolday",
  "private": true,
  "version": "0.1.0",
  "description": "A self-hosted daily dashboard for school schedules, assignments, and grades.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRyankees08/schoolday.git"
  },
  "bugs": {
    "url": "https://github.com/RRyankees08/schoolday/issues"
  },
  "homepage": "https://github.com/RRyankees08/schoolday#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:integrations": "node --env-file=.env ./node_modules/vite/bin/vite.js dev",
    "studentvue:poc": "node --env-file=.env --experimental-strip-types scripts/studentvue-poc.ts",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.10.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
